# Configuración del Proyecto - El Operador
# Copia este archivo a .env y completa los valores

# Directorios
PROJ_DIR=.
REMOTE_PATH=/home/operador/operador

# Credenciales y Red (VPS)
# NO subas el archivo .env real al repositorio
REMOTE_HOST=tu_ip_vps
REMOTE_PORT=22
REMOTE_USER=operador
SSH_KEY_PATH=~/.ssh/id_rsa

# Configuración de la aplicación
LOG_LEVEL=INFO
DEBUG=False

# API Keys (Telegram, etc)
TELEGRAM_TOKEN=tu_token_aqui
N8N_API_KEY=tu_n8n_key_aqui
