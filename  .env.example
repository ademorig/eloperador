# Configuración del Proyecto - El Operador
# Copia este archivo a .env y completa los valores

# Directorios y Rutas
PROJ_DIR=.
REMOTE_PATH=/home/operador/operador
PYTHONPATH=.

# Credenciales y Red (VPS)
# NO subas el archivo .env real al repositorio
REMOTE_HOST=tu_ip_vps
REMOTE_PORT=22
REMOTE_USER=operador
SSH_KEY_PATH=~/.ssh/id_rsa

# Configuración de Servidores
DASHBOARD_PORT=3847
DASHBOARD_HOST=0.0.0.0

# API Keys y Tokens
TELEGRAM_TOKEN=tu_token_aqui
TELEGRAM_CHAT_ID=tu_chat_id_aqui
N8N_API_KEY=tu_n8n_key_aqui
N8N_MCP_URL=http://localhost:5678/mcp
N8N_API_TOKEN=tu_n8n_token_aqui

# Configuración de la aplicación
LOG_LEVEL=INFO
DEBUG=False
